VITE_AUTH_ENABLED=true

# --- Server only (never VITE_*) ---
# Prefer Supabase **transaction pooler** URI for Vercel serverless (port 6543).
# Format (password from Supabase Dashboard → Database → Connection string):
# DATABASE_URL=postgresql://postgres.qdeozgkmrqectbuhetvc:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
#
# Also accepted (same meaning):
# POSTGRES_URL=
# POSTGRES_PRISMA_URL=
# SUPABASE_DB_URL=

